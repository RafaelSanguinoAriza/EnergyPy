# ------------------------------------------------------------------
# EnergyPy — .gitignore
# Archivos generados, dependencias y material sensible que NO deben
# publicarse en el repositorio.
# ------------------------------------------------------------------

# --- Dependencias -------------------------------------------------
node_modules/
.pnpm-store/

# --- Salidas de compilación / build --------------------------------
build/
dist/
.svelte-kit/
src-tauri/target/
src-tauri/gen/schemas/
coverage/
.vite/

# --- Claves y secretos (¡nunca publicar!) ---------------------------
# Clave privada de firma de actualizaciones (TAURI_SIGNING_PRIVATE_KEY)
.updater-key
.updater-key.pub
*.pem
*.key
!test/**/*.pem
.env
.env.*
!.env.example
*.local

# --- Registros (logs) ------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cachés y temporales ----------------------------------------------
.cache/
.tmp/
*.tsbuildinfo
.eslintcache
.DS_Store

# --- Sistema operativo ------------------------------------------------
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- IDE / editor ------------------------------------------------------
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
.vscode/*.log

# --- Repositorios anidados / miscelánea --------------------------------
*.orig
*.rej
.tauri/
