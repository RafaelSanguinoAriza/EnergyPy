{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnergyPy",
  "version": "2.0.1",
  "identifier": "com.energypy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "EnergyPy - Power Control",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EnergyPy",
    "category": "Utility",
    "shortDescription": "EnergyPy - Power Control",
    "longDescription": "Schedule shutdown, restart, suspend and lock actions with real-time system monitoring.",
    "copyright": "Copyright (c) 2026 EnergyPy contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "startMenuFolder": "EnergyPy",
        "headerImage": "bundle-images/header.bmp",
        "sidebarImage": "bundle-images/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "bundle-images/wix_banner.bmp",
        "dialogImagePath": "bundle-images/wix_dialog.bmp",
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxOTJDMzZCRTQxNDlBQ0YKUldUUG1oVGthOE9TUWQxUXdlWWhzTVVUN3JPeGNiTytDekpLejBFVmRvVG5pckg1MzN0dW1hMkkK",
      "endpoints": [
        "https://github.com/RafaelSanguinoAriza/EnergyPy/releases/latest/download/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
